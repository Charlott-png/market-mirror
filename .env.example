# Copy this file to .env for local development. Market Mirror loads .env without
# replacing values already set by scripts/local.ps1 or a hosting environment.
# Never commit .env or paste a real API key into source code, screenshots or chat.
APP_ENV=production
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql+psycopg://marketmirror:REPLACE_PASSWORD@db:5432/marketmirror
TRUSTED_HOSTS=market.example.com
UPLOAD_FOLDER=/data/uploads
AI_FOLDER=/data/ai

# Optional MM-024 live image suggestions. Change enabled to true only after
# adding your own private Gemini key. Free-tier content may be used by Google
# to improve its products; use ordinary product photos, not personal images.
VISION_AI_ENABLED=false
VISION_AI_PROVIDER=gemini
VISION_AI_MODEL=gemini-3.5-flash-lite
VISION_AI_TIMEOUT_SECONDS=12
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# Optional MM-027 product-discovery chat. It reuses GEMINI_API_KEY but has an
# independent switch, model and timeout. Keep disabled if you do not want calls.
SHOP_ASSISTANT_ENABLED=false
SHOP_ASSISTANT_MODEL=gemini-3.5-flash-lite
SHOP_ASSISTANT_TIMEOUT_SECONDS=12

# Optional retained MM-023 provider instead of Gemini:
# VISION_AI_PROVIDER=openai
# VISION_AI_MODEL=gpt-6-luna
# OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
